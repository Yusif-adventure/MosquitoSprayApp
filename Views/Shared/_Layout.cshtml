<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <main class="page-shell">
        @await Html.PartialAsync("_Flash")
        @RenderBody()
    </main>
    <script src="~/js/theme.js" asp-append-version="true" defer></script>
    <script src="~/js/local-time.js" asp-append-version="true" defer></script>
    <script src="~/js/ui.js" asp-append-version="true" defer></script>
    <script src="~/js/devices.js" asp-append-version="true" defer></script>
    <script src="~/js/schedule.js" asp-append-version="true" defer></script>
    <script src="~/js/spray.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

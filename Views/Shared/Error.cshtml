@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-card mobile-shell">
    <div class="empty-state">
        <strong>Something went wrong</strong>
        <span>We couldn't complete your request. Please try again in a moment.</span>
        @if (Model.ShowRequestId)
        {
            <small>Reference: <code>@Model.RequestId</code></small>
        }
        <a asp-action="Index" asp-controller="Home" class="primary-btn">Back to start</a>
    </div>
</div>

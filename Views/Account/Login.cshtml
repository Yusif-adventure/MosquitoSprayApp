@model SmartMosquitoControl.Models.LoginViewModel
@inject SmartMosquitoControl.Services.ExternalAuthInfo ExternalAuth
@{
    ViewData["Title"] = "Login";
}

<div class="page-card mobile-shell login-shell">
    <div class="login-back-row">
        <a asp-action="Index" asp-controller="Home" class="back-arrow" aria-label="Back to welcome">←</a>
    </div>

    <div class="login-panel">
        <h2>Welcome Back</h2>
        <p>Sign in to access your device and control your mosquito system.</p>

        @if (TempData["SignedOut"] is not null)
        {
            <div class="signed-out-message" role="status">You have been signed out.</div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">✉</span>
                <label asp-for="EmailOrPhone"></label>
                <input asp-for="EmailOrPhone" placeholder="Email or Phone Number" autocomplete="username" />
                <span asp-validation-for="EmailOrPhone" class="field-validation-error"></span>
            </div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">▣</span>
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" placeholder="Password" autocomplete="current-password"
                       data-password-input />
                <button type="button" class="password-toggle" aria-label="Show password" data-password-toggle>◉</button>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <button type="submit" class="primary-btn wide">Sign In</button>
        </form>

        @if (ViewBag.ShowResend == true || TempData["ShowResend"] is true)
        {
            <form asp-action="ResendConfirmation" asp-controller="Account" method="post" class="resend-form">
                <p>Didn't get the confirmation email?</p>
                @if (string.IsNullOrEmpty((string?)ViewBag.ResendEmail))
                {
                    <div class="field login-field">
                        <input name="email" type="email" placeholder="Your email address" autocomplete="email" required />
                    </div>
                }
                else
                {
                    <input type="hidden" name="email" value="@ViewBag.ResendEmail" />
                }
                <button type="submit" class="secondary-btn wide">Resend confirmation email</button>
            </form>
        }

        <p class="signup-note">Don't have an account? <a asp-action="Register" asp-controller="Account">Sign Up</a></p>

        @if (ExternalAuth.GoogleEnabled)
        {
            <div class="auth-divider">
                <span>or</span>
            </div>

            <form asp-action="ExternalLogin" asp-controller="Account" method="post" class="external-auth-form">
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <button type="submit" class="google-btn wide">
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align: middle; margin-right: 8px;">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Continue with Google
                </button>
            </form>
        }
    </div>
</div>

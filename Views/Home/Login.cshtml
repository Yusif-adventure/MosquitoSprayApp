@model SmartMosquitoControl.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="page-card mobile-shell login-shell">
    <div class="login-back-row">
        <a asp-action="Index" class="back-arrow" aria-label="Back to welcome">←</a>
    </div>

    <div class="login-panel">
        <h2>Welcome Back</h2>
        <p>Sign in to access your device and control your mosquito system.</p>

        @if (TempData["SignedOut"] is not null)
        {
            <div class="signed-out-message" role="status">You have been signed out.</div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">✉</span>
                <label asp-for="EmailOrPhone"></label>
                <input asp-for="EmailOrPhone" placeholder="Email or Phone Number" autocomplete="username" />
                <span asp-validation-for="EmailOrPhone" class="field-validation-error"></span>
            </div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">▣</span>
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" placeholder="Password" autocomplete="current-password"
                       data-password-input />
                <button type="button" class="password-toggle" aria-label="Show password" data-password-toggle>◉</button>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <a asp-action="Index" class="link-text">Forgot Password?</a>

            <button type="submit" class="primary-btn wide">Sign In</button>
        </form>

        <div class="or-divider"><span>or</span></div>
        <button type="button" class="social-btn"><span class="google-mark" aria-hidden="true">G</span>Continue with
            Google</button>
            <p class="signup-note">Don't have an account? <a href="#">Sign Up</a></p>
        </div>
    </div>

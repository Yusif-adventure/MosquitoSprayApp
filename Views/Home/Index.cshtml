@{
    ViewData["Title"] = "Smart Mosquito Control";
}

<div class="intro-page">
    <div class="intro-device-shell">
        <div class="intro-content">
            <div class="brand-orb">
                <img src="~/images/mosquito-logo.svg" alt="Mosquito silhouette logo" />
            </div>

            <h1>Smart Mosquito<br />Control</h1>
            <p>Cleaner spaces. Healthier lives.</p>

            <div class="intro-copy">
                <span>Automated indoor mosquito control</span>
                <span>with IoT scheduling, control, and monitor</span>
                <span>your device — all from your phone.</span>
            </div>

            <a asp-action="Login" asp-controller="Account" class="primary-btn intro-primary">Get Started</a>
            <a asp-action="Login" asp-controller="Account" class="secondary-btn intro-secondary">Learn More</a>
        </div>
    </div>
</div>

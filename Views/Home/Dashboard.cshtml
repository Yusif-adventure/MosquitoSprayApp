@model SmartMosquitoControl.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-card mobile-shell dashboard-shell">
    
    <div class="dashboard-topbar">
        <div class="profile-pill">
            <span class="profile-avatar">@Model.UserAvatarLetter</span>
        </div>
        <div class="profile-meta">
            <span class="welcome-line">@Model.Greeting</span>
            <strong>@Model.UserFirstName</strong>
        </div>
        <a asp-action="Notifications" asp-controller="Home" class="notification-button" aria-label="Notifications">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5" />
                <path d="M10 20a2 2 0 0 0 4 0" />
            </svg>
            @if (Model.UnreadNotificationCount > 0)
            {
                <span class="notification-dot" aria-hidden="true"></span>
            }
        </a>
    </div>

    <div class="device-card">
        <div class="device-card-top">
            <div class="device-badge"></div>
            <div class="device-info">
                <div class="device-name">@(Model.Device?.Name ?? "No device linked")</div>
                <div class="device-status @(Model.Device?.IsOnline == true ? "online" : "offline")">
                    ● @(Model.Device?.IsOnline == true ? "Online" : "Offline")
                </div>
            </div>
            <div class="chevron">›</div>
        </div>
    </div>

    <div class="device-circle-wrap">
        <div class="device-circle">
            <div class="circle-inner">
                <img src="~/images/mosquito-ready.svg" alt="Mosquito silhouette" />
                <span>Ready</span>
                <small>No spraying in progress</small>
            </div>
        </div>
    </div>

    <div class="stat-grid">
        <div class="mini-stat">
            <span class="mini-label">Insecticide Level</span>
            <strong>@(Model.Device?.InsecticideLevel.ToString() ?? "--")%</strong>
        </div>
        <div class="mini-stat">
            <span class="mini-label">Next Schedule</span>
            @if (Model.NextSchedule is not null)
            {
                <strong>@Html.LocalTime(Model.NextSchedule.ScheduledFor, "day")</strong>
                <small>@Html.LocalTime(Model.NextSchedule.ScheduledFor, "time")</small>
            }
            else
            {
                <strong>None</strong>
            }
        </div>
    </div>

    <div class="quick-actions">
        <a asp-action="ManualSpray" asp-controller="Devices" class="action-box">
            <span class="action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <g transform="rotate(-16 12 12)">
                        <path d="M8 12h9v7a2 2 0 0 1-2 2h-5a2 2 0 0 1-2-2v-7Z" />
                        <path d="M10 12V9h5v3M11 9V6h6l2 1-2 2h-4M15 9c2 1 2 2.4 1 4" />
                    </g>
                    <path d="m19 4 1-1M21 7h2M20 10l1 1" />
                </svg>
            </span>
            <span>Spray Now</span>
        </a>
    </div>

    @await Html.PartialAsync("_NavBar", "Dashboard")
</div>

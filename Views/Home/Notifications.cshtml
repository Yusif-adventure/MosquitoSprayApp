@model IEnumerable<SmartMosquitoControl.Models.NotificationItem>
@{
    ViewData["Title"] = "Notifications";
}

<div class="page-card mobile-shell">
    <div class="screen-header">
        <a asp-action="Dashboard" class="header-left back-link" aria-label="Back to dashboard">←</a>
        <div class="header-center title">Notifications</div>
        <div class="header-right"></div>
    </div>

    <div class="notice-list">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <strong>No notifications</strong>
                <span>Device updates will appear here.</span>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="notice-item @item.SeverityCssClass">
                    <span class="notice-icon">@((item.SeverityCssClass == "warning") ? "!" : (item.SeverityCssClass == "success") ? "✓" : "i")</span>
                    <div>
                        <strong>@item.Title</strong>
                        <p>@item.Message</p>
                    </div>
                    <small>@item.CreatedAt.ToLocalTime().ToString("ddd, h:mm tt")</small>
                </div>
            }
        }
    </div>

    @await Html.PartialAsync("_NavBar", "Dashboard")
</div>

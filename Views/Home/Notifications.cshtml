@model IEnumerable<SmartMosquitoControl.Models.NotificationItem>
@{
    ViewData["Title"] = "Notifications";
}

<div class="page-card mobile-shell">
    <div class="screen-header">
        <a asp-action="Dashboard" asp-controller="Home" class="header-left back-link" aria-label="Back to dashboard">←</a>
        <div class="header-center title">Notifications</div>
        <div class="header-right">
            @if (Model.Any(n => !n.IsRead))
            {
                <form asp-action="MarkAllRead" asp-controller="Home" method="post">
                    <button type="submit" class="link-button" title="Mark all notifications as read">Mark read</button>
                </form>
            }
        </div>
    </div>

    <div class="notice-list">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <strong>No notifications</strong>
                <span>Device updates will appear here.</span>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="notice-item @item.SeverityCssClass @(item.IsRead ? "is-read" : "")">
                    <span class="notice-icon">@((item.SeverityCssClass == "warning") ? "!" : (item.SeverityCssClass == "success") ? "✓" : "i")</span>
                    <div>
                        <strong>@item.Title</strong>
                        <p>@item.Message</p>
                    </div>
                    <small>@Html.LocalTime(item.CreatedAt, "datetime")</small>
                </div>
            }
        }
    </div>

    @await Html.PartialAsync("_NavBar", "Dashboard")
</div>

@model SmartMosquitoControl.Models.SettingsViewModel
@{
    ViewData["Title"] = "Profile & Settings";
}

<div class="page-card mobile-shell">
    <div class="screen-header">
        <a asp-action="Dashboard" class="header-left back-link" aria-label="Back to dashboard">←</a>
        <div class="header-center title">Profile &amp; Settings</div>
        <div class="header-right"></div>
    </div>

    <button class="profile-top settings-disclosure" type="button" aria-expanded="false" aria-controls="settings-options" data-settings-toggle>
        <span class="avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="3" /><path d="M9 7h6M9 11h6M9 15h3M10 18h4" /></svg>
        </span>
        <span class="settings-disclosure-copy">
            <strong>Device Management</strong>
            <small>Manage your connected device settings</small>
        </span>
        <span class="settings-disclosure-chevron" aria-hidden="true">⌄</span>
    </button>

    <div class="settings-list" id="settings-options" data-settings-options hidden>
        @if (ViewBag.SettingsSaved == true)
        {
            <p class="settings-saved" role="status">Settings saved.</p>
        }

        <section class="settings-section" aria-labelledby="appearance-heading">
            <h2 id="appearance-heading"><span class="settings-heading-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" /><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.8-.6a8 8 0 0 1-1.4.8l-.3 1.9h-2.8l-.3-1.9a8 8 0 0 1-1.4-.8l-1.8.6-1.4-2.4 1.4-1.1a7 7 0 0 1 0-1.7l-1.4-1.1 1.4-2.4 1.8.6a8 8 0 0 1 1.4-.8l.3-1.9h2.8l.3 1.9a8 8 0 0 1 1.4.8l1.8-.6 1.4 2.4-1.4 1.1a7 7 0 0 1 0 1.6Z" /></svg></span>App Settings</h2>
            <div class="setting-control-row">
                <span><strong>Dark mode</strong><small>Use a darker color theme</small></span>
                <button class="settings-switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode" data-dark-mode-toggle></button>
            </div>
        </section>

        <form asp-action="SaveSettings" method="post" class="settings-form">
            @Html.AntiForgeryToken()
            <section class="settings-section" aria-labelledby="spray-duration-heading">
                <h2 id="spray-duration-heading"><span class="settings-heading-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 2h6v2H9zM11 6h2v7l4 2-1 1.7-5-2.7V6Z" /><circle cx="12" cy="13" r="9" /></svg></span>Spray Duration</h2>
                <div class="spray-duration-setting">
                    <label asp-for="SprayDurationSeconds">
                        <strong>Cycle length</strong>
                        <small>Move the slider to increase or decrease spray time.</small>
                    </label>
                    <div class="spray-duration-control">
                        <input asp-for="SprayDurationSeconds" type="range" min="10" max="120" step="5" data-spray-duration-setting />
                        <output data-spray-duration-value>@Model.SprayDurationSeconds sec</output>
                    </div>
                    <div class="spray-duration-range"><span>10 sec</span><span>120 sec</span></div>
                </div>
            </section>
            <section class="settings-section" aria-labelledby="alerts-heading">
                <h2 id="alerts-heading"><span class="settings-heading-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" /></svg></span>Notification Preferences</h2>
                <label class="threshold-setting" for="LowInsecticideThreshold">
                    <span><strong>Low insecticide alert</strong><small>Notify me when the level reaches</small></span>
                    <span class="threshold-input"><input asp-for="LowInsecticideThreshold" min="5" max="80" step="5" /><span>%</span></span>
                </label>
                <label class="setting-control-row">
                    <span><strong>Low-level alerts</strong><small>Show a notification when the threshold is reached</small></span>
                    <input asp-for="LowInsecticideAlertsEnabled" class="settings-checkbox" />
                </label>
                <label class="setting-control-row">
                    <span><strong>Spray activity</strong><small>Notify me when a spray cycle starts</small></span>
                    <input asp-for="SprayNotificationsEnabled" class="settings-checkbox" />
                </label>
            </section>
            <button type="submit" class="primary-btn save-settings">Save Settings</button>
        </form>

    </div>

    <section class="settings-quick-links" aria-labelledby="other-options-heading">
        <h2 id="other-options-heading">Other options</h2>
        <a asp-action="LinkedDevices" class="setting-item">
            <span class="setting-item-copy">
                <span class="setting-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4M7 8h10M7 12h6" /></svg></span>
                <span><strong>Linked Devices</strong><small>Manage devices connected to your account</small></span>
            </span>
            <span class="setting-chevron" aria-hidden="true">›</span>
        </a>
        <a asp-action="Monitoring" class="setting-item">
            <span class="setting-item-copy">
                <span class="setting-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 3h6v3l2 2v11a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V8l2-2V3Z" /><path d="M9 6h6M10 12h4M10 16h4" /></svg></span>
                <span><strong>Insecticide Level</strong><small>View current level and refill status</small></span>
            </span>
            <span class="setting-chevron" aria-hidden="true">›</span>
        </a>
        <a asp-action="Privacy" class="setting-item">
            <span class="setting-item-copy">
                <span class="setting-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" /><path d="M9.7 9a2.4 2.4 0 1 1 4.2 1.6c-1.1 1-1.9 1.4-1.9 3M12 17.5h.01" /></svg></span>
                <span><strong>Help &amp; Support</strong><small>FAQs and contact information</small></span>
            </span>
            <span class="setting-chevron" aria-hidden="true">›</span>
        </a>
        <form asp-action="Logout" method="post" class="setting-logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="setting-item danger">
                <span class="setting-item-copy">
                    <span class="setting-icon logout-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M14 8l4 4-4 4M18 12H9" /></svg></span>
                    <span><strong>Log Out</strong><small>Sign out of your account</small></span>
                </span>
                <span class="setting-chevron" aria-hidden="true">›</span>
            </button>
        </form>
    </section>

    @await Html.PartialAsync("_NavBar", "Profile")
</div>

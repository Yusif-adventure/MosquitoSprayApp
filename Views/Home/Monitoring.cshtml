@model SmartMosquitoControl.Controllers.MonitoringViewModel
@{
    ViewData["Title"] = "Monitoring";
}

<div class="page-card mobile-shell">
    <div class="screen-header">
        <div class="header-left">←</div>
        <div class="header-center title">Device Monitoring</div>
        <div class="header-right"></div>
    </div>

    <div class="monitor-panel">
        <div class="monitor-row">
            <span class="label">Device Status</span>
            <span class="status online">● @(Model.Device.IsOnline ? "Online" : "Offline")</span>
        </div>
        <div class="monitor-row secondary">
            <span>Last seen: @Model.Device.LastSeen.ToString("ddd, MMM d, yyyy")</span>
        </div>
        <div class="meter-row">
            <span>Insecticide Level</span>
            <strong>@Model.Device.InsecticideLevel%</strong>
        </div>
        <div class="meter-bar"><span style="width:@Model.Device.InsecticideLevel%"></span></div>
    </div>

    <div class="history-card">
        <div class="history-header">
            <span>Spray History</span>
            <a href="#">View all</a>
        </div>
        <ul>
            @if (!Model.History.Any())
            {
                <li class="empty-row">No spray history yet.</li>
            }
            else
            {
                @foreach (var item in Model.History)
                {
                    <li>
                        <span>@item.Time.ToString("MMM d, yyyy, h:mm tt")</span>
                        <em>@item.Type</em>
                        <span class="check">✓</span>
                    </li>
                }
            }
        </ul>
    </div>

    <div class="nav-bar compact">
        <a asp-action="Dashboard"><span class="nav-icon" aria-hidden="true">⌂</span><span>Home</span></a>
        <a asp-action="Schedule"><span class="nav-icon" aria-hidden="true">▣</span><span>Schedule</span></a>
        <a asp-action="Monitoring" class="active"><span class="nav-icon"
                                                            aria-hidden="true">◷</span><span>History</span></a>
            <a asp-action="Profile"><span class="nav-icon" aria-hidden="true">⚙</span><span>Settings</span></a>
        </div>
    </div>

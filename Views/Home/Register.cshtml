@model SmartMosquitoControl.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="page-card mobile-shell login-shell">
    <div class="login-back-row">
        <a asp-action="Login" class="back-arrow" aria-label="Back to login">←</a>
    </div>

    <div class="login-panel">
        <h2>Create Account</h2>
        <p>Join us to start controlling your mosquito system.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">👤</span>
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" placeholder="First Name (Optional)" />
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
            </div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">👤</span>
                <label asp-for="LastName"></label>
                <input asp-for="LastName" placeholder="Last Name (Optional)" />
                <span asp-validation-for="LastName" class="field-validation-error"></span>
            </div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">✉</span>
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" placeholder="Email Address" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">▣</span>
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" placeholder="Password" autocomplete="new-password"
                       data-password-input />
                <button type="button" class="password-toggle" aria-label="Show password" data-password-toggle>◉</button>
                <span asp-validation-for="Password" class="field-validation-error"></span>
                <div class="password-hint">
                    Password must contain at least one uppercase letter, one lowercase letter, one digit, and one special character
                </div>
            </div>

            <div class="field login-field">
                <span class="field-icon" aria-hidden="true">▣</span>
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" autocomplete="new-password"
                       data-password-input />
                <button type="button" class="password-toggle" aria-label="Show password" data-password-toggle>◉</button>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="primary-btn wide">Create Account</button>
        </form>

        <p class="signup-note">Already have an account? <a asp-action="Login">Sign In</a></p>

        <div class="auth-divider">
            <span>or</span>
        </div>

        <form asp-action="ExternalLogin" method="post" class="external-auth-form">
            <input type="hidden" name="provider" value="Google" />
            <button type="submit" class="google-btn wide">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align: middle; margin-right: 8px;">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Continue with Google
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
